{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ti.muse/bandsheet/schemas/playlist.schema.json",
  "title": "Bandsheet Playlist v1",
  "type": "object",
  "required": ["schemaVersion", "playlistId", "title", "bandId", "songs"],
  "properties": {
    "schemaVersion": {"const": 1},
    "playlistId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"},
    "title": {"type": "string", "minLength": 1},
    "bandId": {"type": "string"},
    "songs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["position", "songId"],
        "properties": {
          "position": {"type": "integer", "minimum": 1},
          "songId": {"type": "string"},
          "note": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
